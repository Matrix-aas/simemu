+#ifdef TARGET_TRICORE
+/* SIMEMU exact instruction timing (uc_ctl 0x5153), see struct uc_simemu_exact. */
 
+/* Is `pc` the address of an instruction that accessed a peripheral (it ends its block)? */
+bool simemu_is_io_site(struct uc_struct *uc, target_ulong pc)
+{
+    struct uc_simemu_exact *x = uc->simemu_exact;
+    uint32_t lo = 0, hi = x->n_io_sites;
+
+    while (lo < hi) {
+        uint32_t mid = lo + (hi - lo) / 2;
+        if (x->io_sites[mid] < pc) {
+            lo = mid + 1;
+        } else {
+            hi = mid;
+        }
+    }
+    return lo < x->n_io_sites && x->io_sites[lo] == pc;
+}
+
+static void simemu_add_io_site(struct uc_struct *uc, uint32_t pc)
+{
+    struct uc_simemu_exact *x = uc->simemu_exact;
+    uint32_t i = 0;
+
+    if (simemu_is_io_site(uc, pc)) {
+        return;
+    }
+    if (x->n_io_sites == x->cap_io_sites) {
+        uint32_t cap = x->cap_io_sites ? 2 * x->cap_io_sites : 256;
+        uint32_t *p = realloc(x->io_sites, cap * sizeof(*p));
+        if (p == NULL) {
+            return; /* no room: the site keeps being re-executed at a block end */
+        }
+        x->io_sites = p;
+        x->cap_io_sites = cap;
+    }
+    while (i < x->n_io_sites && x->io_sites[i] < pc) {
+        i++;
+    }
+    memmove(&x->io_sites[i + 1], &x->io_sites[i], (x->n_io_sites - i) * sizeof(uint32_t));
+    x->io_sites[i] = pc;
+    x->n_io_sites++;
+}
+
+/* Called before a peripheral access of translated code (io_readx/io_writex). The block prologue
+ * counted the whole block in *executed; while the access runs, *executed must be the number of
+ * instructions retired before the accessing one, and the accessing instruction must be the last of
+ * its block, so that a stop requested by the access takes effect at the next instruction (QEMU's
+ * deterministic I/O rule, cf. cpu_io_recompile). An instruction found in the middle of a block is
+ * recorded as an I/O site (blocks are then translated to end after it), the block is dropped and
+ * the instruction is executed again from its start; nothing of it has run yet. Returns the amount
+ * taken off *executed, to be added back after the access. */
+uint64_t simemu_io_begin(CPUState *cpu, uintptr_t retaddr)
+{
+    struct uc_struct *uc = cpu->uc;
+    TCGContext *tcg_ctx = uc->tcg_ctx;
+    TranslationBlock *tb;
+    target_ulong data[TARGET_INSN_START_WORDS] = { 0 };
+    uintptr_t host_pc, searched;
+    uint8_t *p;
+    uint64_t back, *executed;
+    int i, j;
+
+    if (!uc->simemu_exact || !uc->simemu_bc || !retaddr ||
+        retaddr - (uintptr_t)tcg_ctx->code_gen_buffer >= tcg_ctx->code_gen_buffer_size) {
+        return 0;
+    }
+    tb = tcg_tb_lookup(tcg_ctx, retaddr);
+    if (!tb) {
+        return 0;
+    }
+    data[0] = tb->pc;
+    host_pc = (uintptr_t)tb->tc.ptr;
+    p = (uint8_t *)tb->tc.ptr + tb->tc.size;
+    searched = retaddr - GETPC_ADJ;
+    for (i = 0; i < tb->icount; ++i) {
+        for (j = 0; j < TARGET_INSN_START_WORDS; ++j) {
+            data[j] += decode_sleb128(&p);
+        }
+        host_pc += decode_sleb128(&p);
+        if (host_pc > searched) {
+            break;
+        }
+    }
+    if (i >= tb->icount) {
+        return 0;
+    }
+    executed = uc->simemu_bc->executed;
+    back = MIN((uint64_t)(tb->icount - i), *executed);
+    if (i + 1 < tb->icount) {
+        simemu_add_io_site(uc, (uint32_t)data[0]);
+        *executed -= back;
+        restore_state_to_opc(cpu->env_ptr, tb, data);
+        tb_phys_invalidate(tcg_ctx, tb, -1);
+        cpu_loop_exit_noexc(cpu);
+    }
+    *executed -= back;
+    return back;
+}
